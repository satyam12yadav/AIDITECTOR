# Exa.ai Web Retrieval API Key (Required for live RAG multi-source evidence search)
# Get key at: https://exa.ai
EXA_API_KEY=

# Google Gemini API Key (Optional: for AI forensic reasoning; fallback uses local deterministic NLI engine)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Port
PORT=5001

# Environment Mode (development, production, test)
NODE_ENV=development

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend API Base URL (used by Vite)
VITE_API_BASE_URL=http://localhost:5001
